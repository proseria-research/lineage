---
interface Props {
	size?: number;
	class?: string;
}
const { size = 22, class: className } = Astro.props;
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 56 56"
	aria-hidden="true"
	focusable="false"
>
	<rect x="10" y="10" width="36" height="36" fill="none" stroke="currentColor" stroke-width="5"></rect>
</svg>
