---
/**
 * The fingerprint mark, ported from the admin console's FingerprintMark (components/
 * VersionMark.tsx) so the site draws the same pixels the product does: four petals, one per
 * hash level, clockwise from the top left — architecture, layer shapes, precision, weights.
 * Each petal's outline and point cloud are seeded from its hash, so the drawing is a
 * deterministic function of the hashes alone. Below 64px the cloud is replaced by solid
 * petals, as in the console.
 */

const RING_ORDER = ['topology', 'shape', 'dtype', 'weights'] as const;
type RingName = (typeof RING_ORDER)[number];

interface Props {
	hashes: Partial<Record<RingName, string>>;
	size?: number;
	/** Levels mapped false are drawn muted, for a side-by-side comparison. */
	emphasis?: Partial<Record<RingName, boolean>>;
	class?: string;
}

const { hashes, size = 160, emphasis, class: className } = Astro.props;

const fnv1a32 = (s: string): number => {
	let h = 0x811c9dc5;
	const bytes = new TextEncoder().encode(s);
	for (let i = 0; i < bytes.length; i++) {
		h ^= bytes[i];
		h = Math.imul(h, 0x01000193) >>> 0;
	}
	return h >>> 0;
};

const stream = (seed: string): (() => number) => {
	let x = fnv1a32(seed) || 0x9e3779b9;
	return () => {
		x ^= x << 13;
		x >>>= 0;
		x ^= x >>> 17;
		x ^= x << 5;
		x >>>= 0;
		return x;
	};
};

const FP_VAR: Record<RingName, string> = {
	topology: 'var(--fp-topology)',
	shape: 'var(--fp-shape)',
	dtype: 'var(--fp-dtype)',
	weights: 'var(--fp-weights)',
};

const PETAL_ANGLE = [-0.75 * Math.PI, -0.25 * Math.PI, 0.25 * Math.PI, 0.75 * Math.PI];

const k = size / 96;
const c = size / 2;
const len = c - Math.max(2, 4 * k);
const small = size < 64;
const f = (n: number) => n.toFixed(2);

type Dot = { x: string; y: string; r: string; fill: string; o: string };
type Petal =
	| { kind: 'absent'; name: RingName; points: string }
	| { kind: 'solid'; name: RingName; points: string; muted: boolean }
	| { kind: 'cloud'; name: RingName; dots: Dot[]; muted: boolean };

const petalPoints = (base: number, width: number, wav: number, depth: number, scale: number) => {
	const pts: string[] = [];
	for (let q = 0; q <= 80; q++) {
		const t = (q / 80) * Math.PI;
		const rr = len * scale * Math.sin(t) * (1 + depth * Math.sin(wav * 2 * t));
		const a = base + (t - Math.PI / 2) * width;
		pts.push(`${f(c + rr * Math.cos(a))},${f(c + rr * Math.sin(a))}`);
	}
	return pts.join(' ');
};

const petals: Petal[] = RING_ORDER.map((name, i) => {
	const h = hashes[name];
	const base = PETAL_ANGLE[i];
	const muted = !!emphasis && !emphasis[name];
	if (!h) return { kind: 'absent', name, points: petalPoints(base, 0.5, 1, 0, 1) };

	const next = stream(h);
	const unit = () => next() / 0xffffffff;
	const width = 0.35 + unit() * 0.35;
	const wav = 2 + (next() % 5);
	const depth = 0.05 + unit() * 0.12;

	if (small) return { kind: 'solid', name, points: petalPoints(base, width, wav, depth, 1), muted };

	const at = (t: number, sc: number): [number, number] => {
		const rr = len * sc * Math.sin(t) * (1 + depth * Math.sin(wav * 2 * t));
		const a = base + (t - Math.PI / 2) * width;
		return [c + rr * Math.cos(a), c + rr * Math.sin(a)];
	};

	const contours = 3 + (next() % 2);
	const perContour = Math.round(80 * Math.max(0.6, width * 1.6));
	const interior = 140;
	const dot = Math.max(0.55, 0.7 * k);
	const jitter = 0.55 * k;
	const own = muted ? 'var(--muted-fg)' : FP_VAR[name];
	const neighbour = (side: -1 | 1) => {
		const n = RING_ORDER[(i + side + 4) % 4];
		return !emphasis && hashes[n] ? FP_VAR[n] : own;
	};
	const colourAt = (t: number) => {
		if (emphasis) return own;
		const w = Math.abs(t - Math.PI / 2) / (Math.PI / 2);
		const mix = Math.round(25 * w * w);
		return mix === 0 ? own : `color-mix(in oklch, ${own} ${100 - mix}%, ${neighbour(t < Math.PI / 2 ? -1 : 1)})`;
	};
	const dotAt = (t: number, sc: number, x: number, y: number, scale: number, alpha: number): Dot => {
		const rho = sc * Math.sin(t);
		return {
			x: f(x),
			y: f(y),
			r: f(dot * scale * (0.3 + 1.25 * Math.pow(rho, 1.4))),
			fill: colourAt(t),
			o: Math.min(1, alpha * (0.85 + 0.15 * rho)).toFixed(3),
		};
	};

	const dots: Dot[] = [];
	for (let ci = 0; ci < contours; ci++) {
		const sc = 1 - ci * 0.2;
		for (let q = 0; q < perContour; q++) {
			const t = ((q + 0.5 + (unit() - 0.5) * 0.6) / perContour) * Math.PI;
			const [x, y] = at(t, sc);
			dots.push(
				dotAt(
					t,
					sc,
					x + (unit() - 0.5) * jitter,
					y + (unit() - 0.5) * jitter,
					(ci === 0 ? 1.2 : 0.95) * (0.75 + unit() * 0.5),
					(ci === 0 ? 1 : 0.9) * (0.9 + unit() * 0.1),
				),
			);
		}
	}
	for (let q = 0; q < interior; q++) {
		const t = 0.08 + unit() * (Math.PI - 0.16);
		const sc = 0.1 + Math.pow(unit(), 0.7) * 0.85;
		const [x, y] = at(t, sc);
		dots.push(dotAt(t, sc, x, y, 0.55 + unit() * 0.5, 0.35 + unit() * 0.4));
	}
	return { kind: 'cloud', name, dots, muted };
});
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox={`0 0 ${size} ${size}`}
	fill="none"
	aria-hidden="true"
	style="display:block;flex:none"
>
	{
		petals.map((p) =>
			p.kind === 'absent' ? (
				<polygon
					points={p.points}
					stroke="var(--muted-fg)"
					stroke-opacity="0.75"
					stroke-width="1.2"
					stroke-dasharray="1.2 3.6"
					stroke-linecap="round"
					fill="none"
				/>
			) : p.kind === 'solid' ? (
				<polygon
					points={p.points}
					style={`color:${p.muted ? 'var(--muted-fg)' : FP_VAR[p.name]}`}
					fill="currentColor"
					fill-opacity={p.muted ? 0.28 : 0.8}
					stroke="currentColor"
					stroke-opacity={p.muted ? 0.5 : 1}
					stroke-width="0.8"
					stroke-linejoin="round"
				/>
			) : (
				<g opacity={p.muted ? 0.55 : 1}>
					{p.dots.map((d) => (
						<circle cx={d.x} cy={d.y} r={d.r} style={`fill:${d.fill}`} fill-opacity={d.o} />
					))}
				</g>
			),
		)
	}
</svg>
