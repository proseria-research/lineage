---
/**
 * The frame every guide diagram shares: a card, an SVG drawn to the text column's width, and a
 * caption. Below the SVG's minimum width it scrolls rather than shrinking its text.
 */
interface Props {
	width: number;
	height: number;
	title: string;
	desc: string;
	minWidth?: number;
}
const { width, height, title, desc, minWidth = 560 } = Astro.props;
const id = `dg-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<figure class="dg not-content">
	<div class="dg__scroll">
		<svg
			viewBox={`0 0 ${width} ${height}`}
			role="img"
			aria-labelledby={`${id}-t ${id}-d`}
			style={`min-width:${minWidth}px`}
		>
			<title id={`${id}-t`}>{title}</title>
			<desc id={`${id}-d`}>{desc}</desc>
			<defs>
				<marker id="dg-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
					<path class="dg__arrowhead" d="M 0 0 L 10 5 L 0 10 z"></path>
				</marker>
			</defs>
			<slot />
		</svg>
	</div>
	{Astro.slots.has('caption') && <figcaption class="dg__caption"><slot name="caption" /></figcaption>}
</figure>
