---
/**
 * The registry board.
 *
 * Four columns, one per lifecycle stage. Promoting the staging candidate moves
 * it into production and archives the incumbent in the same beat — which is
 * exactly what the API does, in one transaction. The resolve line underneath
 * shows what a serving system would get back the instant that happens.
 */

const fnv = (input: string): number => {
	let hash = 2166136261;
	for (let i = 0; i < input.length; i++) {
		hash ^= input.charCodeAt(i);
		hash = Math.imul(hash, 16777619);
	}
	return hash >>> 0;
};

const digestOf = (version: string) => fnv(`digest:${version}`).toString(16).padStart(8, '0').slice(0, 8);
const sizeOf = (version: string) => 180 + (fnv(`size:${version}`) % 720);

const stages = [
	{ key: 'draft', label: 'Draft', versions: ['1.5.0', '1.6.0'] },
	{ key: 'staging', label: 'Staging', versions: ['1.4.0'] },
	{ key: 'production', label: 'Production', versions: ['1.3.0'] },
	{ key: 'archived', label: 'Archived', versions: ['1.2.0', '1.1.0'] },
];
---

<figure class="board" data-board>
	<figcaption class="board__head">
		<span class="eyebrow"><i class="sq" aria-hidden="true"></i>registry board</span>
		<span class="board__model">fraud-detector</span>
		<button class="board__action" type="button" data-promote>
			Promote <span data-candidate>1.4.0</span>
		</button>
	</figcaption>

	<div class="board__grid">
		{
			stages.map((stage) => (
				<section class="col" data-col={stage.key}>
					<h3 class="col__head">
						<span>{stage.label}</span>
						<span class="col__count" data-count>
							{stage.versions.length}
						</span>
					</h3>
					<ol class="col__stack" data-stack>
						{stage.versions.map((version) => (
							<li class="card" data-card data-version={version}>
								<span class="card__name">{version}</span>
								<span class="card__meta">
									sha256:{digestOf(version)} · {sizeOf(version)} MB
								</span>
							</li>
						))}
					</ol>
				</section>
			))
		}
	</div>

	<p class="board__resolve">
		<span class="board__verb">GET</span>
		<code>/v1/models/fraud-detector/resolve?stage=production</code>
		<span class="board__arrow" aria-hidden="true">→</span>
		<output class="board__result" data-resolved
			>1.3.0 · sha256:{digestOf('1.3.0')} · s3://models/fraud-detector/1.3.0</output
		>
	</p>
</figure>

<script>
	const board = document.querySelector<HTMLElement>('[data-board]');

	if (board) {
		const fnv = (input: string): number => {
			let hash = 2166136261;
			for (let i = 0; i < input.length; i++) {
				hash ^= input.charCodeAt(i);
				hash = Math.imul(hash, 16777619);
			}
			return hash >>> 0;
		};
		const digestOf = (v: string) => fnv(`digest:${v}`).toString(16).padStart(8, '0').slice(0, 8);
		const sizeOf = (v: string) => 180 + (fnv(`size:${v}`) % 720);

		const stack = (name: string) =>
			board.querySelector<HTMLElement>(`[data-col="${name}"] [data-stack]`)!;
		const columns = {
			draft: stack('draft'),
			staging: stack('staging'),
			production: stack('production'),
			archived: stack('archived'),
		};

		const button = board.querySelector<HTMLButtonElement>('[data-promote]')!;
		const candidateLabel = board.querySelector<HTMLElement>('[data-candidate]')!;
		const resolved = board.querySelector<HTMLElement>('[data-resolved]')!;
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

		const ARCHIVE_LIMIT = 3;
		let nextMinor = 7;
		let busy = false;

		const makeCard = (version: string) => {
			const card = document.createElement('li');
			card.className = 'card card--entering';
			card.dataset.card = '';
			card.dataset.version = version;
			card.innerHTML =
				`<span class="card__name">${version}</span>` +
				`<span class="card__meta">sha256:${digestOf(version)} · ${sizeOf(version)} MB</span>`;
			return card;
		};

		const syncCounts = () => {
			for (const [name, list] of Object.entries(columns)) {
				const count = board.querySelector<HTMLElement>(`[data-col="${name}"] [data-count]`);
				if (count) count.textContent = String(list.children.length);
			}
			const candidate = columns.staging.firstElementChild as HTMLElement | null;
			candidateLabel.textContent = candidate?.dataset.version ?? '—';
		};

		const promote = () => {
			if (busy) return;
			const candidate = columns.staging.firstElementChild as HTMLElement | null;
			const incumbent = columns.production.firstElementChild as HTMLElement | null;
			const nextDraft = columns.draft.firstElementChild as HTMLElement | null;
			if (!candidate) return;

			busy = true;
			board.classList.add('is-promoting');

			// FIRST — where every card sits before the transition.
			const moving = [...board.querySelectorAll<HTMLElement>('[data-card]')];
			const before = new Map(moving.map((card) => [card, card.getBoundingClientRect()]));

			// The transition itself, exactly as the API orders it.
			if (incumbent) columns.archived.prepend(incumbent);
			columns.production.append(candidate);
			if (nextDraft) columns.staging.append(nextDraft);
			const fresh = makeCard(`1.${nextMinor++}.0`);
			columns.draft.append(fresh);
			while (columns.archived.children.length > ARCHIVE_LIMIT) {
				columns.archived.lastElementChild?.remove();
			}

			const version = candidate.dataset.version!;
			resolved.textContent = `${version} · sha256:${digestOf(version)} · s3://models/fraud-detector/${version}`;
			syncCounts();

			// LAST + INVERT + PLAY.
			if (!reduceMotion.matches) {
				for (const card of moving) {
					const start = before.get(card);
					if (!start || !card.isConnected) continue;
					const end = card.getBoundingClientRect();
					const dx = start.left - end.left;
					const dy = start.top - end.top;
					if (!dx && !dy) continue;
					card.animate(
						[{ transform: `translate(${dx}px, ${dy}px)` }, { transform: 'translate(0, 0)' }],
						{ duration: 620, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' },
					);
				}
			}

			requestAnimationFrame(() => fresh.classList.remove('card--entering'));
			window.setTimeout(
				() => {
					board.classList.remove('is-promoting');
					busy = false;
				},
				reduceMotion.matches ? 0 : 640,
			);
		};

		button.addEventListener('click', promote);
		syncCounts();

		// Demonstrate the invariant once, when the board first comes into view.
		if (!reduceMotion.matches) {
			const observer = new IntersectionObserver(
				(entries) => {
					for (const entry of entries) {
						if (!entry.isIntersecting) continue;
						observer.disconnect();
						window.setTimeout(promote, 1100);
					}
				},
				{ threshold: 0.4 },
			);
			observer.observe(board);
		}
	}
</script>
