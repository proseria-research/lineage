---
import Mark from './Mark.astro';

const columns = [
	{
		title: 'Start',
		links: [
			{ label: 'Introduction', href: '/start/introduction/' },
			{ label: 'Quickstart', href: '/start/quickstart/' },
			{ label: 'Data model', href: '/start/data-model/' },
			{ label: 'Python SDK and CLI', href: '/clients/sdk-cli/' },
		],
	},
	{
		title: 'Model API',
		links: [
			{ label: 'Publishing', href: '/api/publishing/' },
			{ label: 'Promotion', href: '/api/promotion/' },
			{ label: 'Resolve and delivery', href: '/api/resolve/' },
			{ label: 'Lineage and fingerprints', href: '/api/lineage/' },
			{ label: 'API conventions', href: '/api/conventions/' },
		],
	},
	{
		title: 'Governance',
		links: [
			{ label: 'Compliance records', href: '/governance/compliance/' },
			{ label: 'Audit and retention', href: '/governance/audit/' },
		],
	},
	{
		title: 'Operate',
		links: [
			{ label: 'Configuration', href: '/operate/configuration/' },
			{ label: 'Deploy with Helm', href: '/operate/deploy/' },
			{ label: 'Storage and databases', href: '/operate/storage/' },
			{ label: 'Observability and security', href: '/operate/observability/' },
		],
	},
];
---

<footer class="footer">
	<div class="footer__inner">
		<div class="footer__brand">
			<a class="wordmark" href="/">
				<Mark size={20} />
				<span>Lineage</span>
			</a>
			<p>The model registry for regulated AI.</p>
			<p class="footer__license">
				Apache 2.0. <a href="https://github.com/proseria-research/lineage">proseria-research/lineage</a>
			</p>
		</div>

		<div class="footer__columns">
			{
				columns.map((column) => (
					<nav aria-label={column.title}>
						<h2 class="footer__heading">{column.title}</h2>
						<ul>
							{column.links.map((link) => (
								<li>
									<a href={link.href}>{link.label}</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>
	</div>
</footer>
