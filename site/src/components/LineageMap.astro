---
/**
 * The lineage map for one version, drawn the way the console's Lineage tab draws it: what the
 * version came from on the left, what depends on it on the right. Relations are shown in plain
 * words; the API names (trained_on, produced_by, derived_from, deployed_as) sit in the
 * accessible description. Hovering an edge lights it and dims the rest.
 *
 * Fixed viewBox: the figure scrolls rather than shrinking on narrow screens, because SVG text
 * that scales down stops being readable long before the layout breaks.
 */

const W = 1080;
const H = 440;

const CENTRE = { x: 415, y: 180, w: 250, h: 84 };
const CY = CENTRE.y + CENTRE.h / 2;
const LEAF = { w: 250, h: 64 };
const LEFT_X = 20;
const RIGHT_X = 810;

type Leaf = { kind: string; name: string; relation: string; cy: number; stage?: string };

const ancestry: Leaf[] = [
	{ kind: 'Dataset', name: 's3://data/transactions-2026-q1', relation: 'trained on', cy: 70 },
	{ kind: 'Pipeline run', name: 'kfp://runs/8b21c4de', relation: 'produced by', cy: 222 },
	{ kind: 'Model version', name: 'fraud-detector 1.2.0', relation: 'derived from', cy: 374, stage: 'Archived' },
];

const impact: Leaf[] = [
	{ kind: 'Deployment', name: 'kserve / prod-eu-1', relation: 'deployed as', cy: 136 },
	{ kind: 'Model version', name: 'fraud-detector-lite 0.1.0', relation: 'derived from it', cy: 308, stage: 'Staging' },
];

const branch = (leaf: Leaf, side: 'left' | 'right', fan: number) =>
	side === 'left'
		? `M ${LEFT_X + LEAF.w} ${leaf.cy} C ${LEFT_X + LEAF.w + 70} ${leaf.cy} ${CENTRE.x - 70} ${CY + fan} ${CENTRE.x} ${CY + fan}`
		: `M ${CENTRE.x + CENTRE.w} ${CY + fan} C ${CENTRE.x + CENTRE.w + 70} ${CY + fan} ${RIGHT_X - 70} ${leaf.cy} ${RIGHT_X} ${leaf.cy}`;

const labelAt = (leaf: Leaf, side: 'left' | 'right') => ({
	x: side === 'left' ? (LEFT_X + LEAF.w + CENTRE.x) / 2 : (CENTRE.x + CENTRE.w + RIGHT_X) / 2,
	y: (leaf.cy + CY) / 2,
});

const nodes = [
	...ancestry.map((leaf, i) => ({ leaf, side: 'left' as const, fan: (i - 1) * 18 })),
	...impact.map((leaf, i) => ({ leaf, side: 'right' as const, fan: i === 0 ? -14 : 14 })),
];
const pillW = (s: string) => s.length * 6.6 + 20;
---

<figure class="map">
	<div class="map__legend" aria-hidden="true">
		<span>Where it came from</span>
		<span>What depends on it</span>
	</div>
	<div class="map__scroll">
		<svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} role="img" aria-labelledby="map-title map-desc">
			<title id="map-title">Lineage of fraud-detector 1.4.0</title>
			<desc id="map-desc">
				fraud-detector 1.4.0 was trained on s3://data/transactions-2026-q1 (trained_on), produced
				by pipeline run kfp://runs/8b21c4de (produced_by), and derived from fraud-detector 1.2.0
				(derived_from). It is deployed as kserve / prod-eu-1 (deployed_as), and fraud-detector-lite
				0.1.0 is derived from it.
			</desc>
			<defs>
				<marker id="map-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
					<path class="map__arrow" d="M 0 0 L 10 5 L 0 10 z"></path>
				</marker>
			</defs>

			{
				nodes.map(({ leaf, side, fan }) => {
					const at = labelAt(leaf, side);
					const x = side === 'left' ? LEFT_X : RIGHT_X;
					const y = leaf.cy - LEAF.h / 2;
					const d = branch(leaf, side, fan);
					const pw = pillW(leaf.relation);
					return (
						<g class="map__edge" tabindex="0">
							<path class="map__hit" d={d} />
							<path class="map__branch" d={d} marker-end="url(#map-arrow)" />
							<rect class="map__pill" x={at.x - pw / 2} y={at.y - 11} width={pw} height="22" rx="11" />
							<text class="map__relation" x={at.x} y={at.y + 4} text-anchor="middle">
								{leaf.relation}
							</text>
							<rect class="map__node" x={x} y={y} width={LEAF.w} height={LEAF.h} rx="8" />
							<text class="map__kind" x={x + 16} y={y + 24}>
								{leaf.kind}
								{leaf.stage && <tspan class="map__stage" data-stage={leaf.stage.toLowerCase()} dx="8">{leaf.stage}</tspan>}
							</text>
							<text class="map__name" x={x + 16} y={y + 46}>
								{leaf.name}
							</text>
						</g>
					);
				})
			}

			<g class="map__subject">
				<rect class="map__node" x={CENTRE.x} y={CENTRE.y} width={CENTRE.w} height={CENTRE.h} rx="10" />
				<text class="map__kind" x={CENTRE.x + 18} y={CENTRE.y + 25}>This version</text>
				<text class="map__subject-name" x={CENTRE.x + 18} y={CENTRE.y + 51}>fraud-detector 1.4.0</text>
				<text class="map__meta" x={CENTRE.x + 18} y={CENTRE.y + 70}>sha256:9f2c4a10…</text>
			</g>
		</svg>
	</div>
</figure>
