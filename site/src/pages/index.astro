---
import Marketing from '../layouts/Marketing.astro';
import ReleaseDemo from '../components/ReleaseDemo.astro';
import LineageMap from '../components/LineageMap.astro';
import Fingerprint from '../components/Fingerprint.astro';
import { byName } from '../lib/demo';

import TriangleAlert from '@lucide/astro/icons/triangle-alert';
import OctagonAlert from '@lucide/astro/icons/octagon-alert';
import Lightbulb from '@lucide/astro/icons/lightbulb';
import Lock from '@lucide/astro/icons/lock';
import FileLock from '@lucide/astro/icons/file-lock';
import Scale from '@lucide/astro/icons/scale';
import Package from '@lucide/astro/icons/package';
import Database from '@lucide/astro/icons/database';
import HardDrive from '@lucide/astro/icons/hard-drive';
import KeyRound from '@lucide/astro/icons/key-round';
import Copy from '@lucide/astro/icons/copy';

const before = byName('1.3.0');
const after = byName('1.4.0');

const LEVELS = [
	{ key: 'topology', label: 'Architecture', help: 'Which layers exist and how they connect' },
	{ key: 'shape', label: 'Layer shapes', help: 'The size of every tensor' },
	{ key: 'dtype', label: 'Precision', help: 'The numeric type of every tensor' },
	{ key: 'weights', label: 'Weights', help: 'The exact weight values' },
] as const;

const levels = LEVELS.map((l) => ({ ...l, changed: before.hashes[l.key] !== after.hashes[l.key] }));

const verdicts = [
	{ name: 'Identical', plain: 'Same bytes. A repackage.' },
	{ name: 'Reweighted', plain: 'New weights. Retraining or fine-tuning.' },
	{ name: 'Recast', plain: 'New precision. Usually quantization.' },
	{ name: 'Rescaled', plain: 'Wider or deeper, same design.' },
	{ name: 'Rearchitected', plain: 'New layers or backbone.' },
];

const steps = [
	{
		title: 'Publish',
		body: 'Register a version and its files. Lineage notes where they live, their digest and size, and what produced them.',
	},
	{
		title: 'Promote',
		body: 'Move it from draft to staging to production. The old version is archived in the same step, and files lock at staging, so what you tested is what ships.',
	},
	{
		title: 'Serve',
		body: 'Your serving code asks for production and gets download links, digests and the format. Promote again and it picks up the new version on its own.',
	},
];

/*
 * The whole flow as one script, in each way a team talks to Lineage. Every line belongs to a
 * step (0 is setup), so choosing a step lights its lines in whichever language is showing.
 * Highlighting is two rules: comments muted, string literals tinted.
 */
type Line = [number, string];
const scripts: { id: string; label: string; file: string; lines: Line[] }[] = [
	{
		id: 'python',
		label: 'Python',
		file: 'release.py',
		lines: [
			[0, 'from lineage import Client'],
			[0, ''],
			[0, 'client = Client("http://lineage:8081")'],
			[0, ''],
			[1, '# 1. Publish a version with its model file'],
			[1, 'client.publish('],
			[1, '    model="fraud-detector",'],
			[1, '    version="1.4.0",'],
			[1, '    artifacts=[client.model_file("model.onnx")],'],
			[1, ')'],
			[0, ''],
			[2, '# 2. Promote it, one stage at a time'],
			[2, 'client.transition("fraud-detector", "1.4.0", to="staging")'],
			[2, 'client.transition("fraud-detector", "1.4.0", to="production",'],
			[2, '                  reason="passed shadow eval")'],
			[0, ''],
			[3, '# 3. Serve whatever is in production'],
			[3, 'client.download("fraud-detector", stage="production",'],
			[3, '                dest="./model")'],
		],
	},
	{
		id: 'cli',
		label: 'CLI',
		file: 'release.sh',
		lines: [
			[0, 'export LINEAGE_SERVER="http://lineage:8081"'],
			[0, ''],
			[1, '# 1. Publish a version with its model file'],
			[1, 'lineage-cli version publish \\'],
			[1, '  -m fraud-detector -n 1.4.0 -a model.onnx'],
			[0, ''],
			[2, '# 2. Promote it, one stage at a time'],
			[2, 'lineage-cli version promote -m fraud-detector -n 1.4.0 --to staging'],
			[2, 'lineage-cli version promote -m fraud-detector -n 1.4.0 --to production'],
			[0, ''],
			[3, '# 3. Serve whatever is in production'],
			[3, 'lineage-cli pull fraud-detector --stage production --dest ./model'],
		],
	},
	{
		id: 'http',
		label: 'HTTP',
		file: 'release.sh',
		lines: [
			[0, 'API="http://lineage:8081/v1/models"'],
			[0, ''],
			[1, '# 1. Publish a version, pointing at its model file'],
			[1, 'curl -X POST "$API" -d \'{"name": "fraud-detector"}\''],
			[1, 'curl -X POST "$API/fraud-detector/versions" -d \'{'],
			[1, '  "name": "1.4.0",'],
			[1, '  "artifacts": [{"name": "model.onnx",'],
			[1, '    "uri": "s3://models/fraud-detector/1.4.0/model.onnx"}]'],
			[1, "}'"],
			[0, ''],
			[2, '# 2. Promote it, one stage at a time'],
			[2, 'V="$API/fraud-detector/versions/1.4.0:transition"'],
			[2, 'curl -X POST "$V" -d \'{"to": "staging"}\''],
			[2, 'curl -X POST "$V" -d \'{"to": "production",'],
			[2, '  "reason": "passed shadow eval"}\''],
			[0, ''],
			[3, '# 3. Ask for production: files, digests and download links'],
			[3, 'curl "$API/fraud-detector/resolve?stage=production"'],
		],
	},
];

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const highlight = (line: string) =>
	line.trimStart().startsWith('#')
		? `<span class="tok-c">${esc(line)}</span>`
		: esc(line).replace(/"[^"]*"/g, (m) => `<span class="tok-s">${m}</span>`) || ' ';
const textOf = (lines: Line[]) => lines.map(([, l]) => l).join('\n');

const attention = [
	{
		tone: 'danger',
		area: 'Change control',
		model: 'triage-assist 3.2.0',
		title: "Shipped a change its plan doesn't allow",
		detail: 'Measured as "rearchitected". The plan in force allows "reweighted" and "recast".',
		action: 'See why',
	},
	{
		tone: 'warn',
		area: 'EU AI Act',
		model: 'credit-scorer',
		title: 'Risk classification may be out of date',
		detail: 'A new version was published after it was assessed.',
		action: 'Re-classify',
	},
	{
		tone: 'warn',
		area: 'Modification review',
		model: 'credit-scorer 2.2.0',
		title: 'Modification waiting for review',
		detail: 'Fine-tuned from credit-scorer 2.1.0, a high-risk model. Someone needs to judge whether the change was substantial.',
		action: 'Review',
	},
];

const programmes = [
	{
		title: 'EU AI Act risk category',
		body: 'Record each model\'s risk category and why. When a new version ships or production changes, Lineage flags the assessment so nobody relies on a stale one.',
		source: 'Regulation (EU) 2024/1689',
	},
	{
		title: 'Modification review',
		body: 'When someone fine-tunes a high-risk model, a reviewer sees what was measured beside what the team said they did, and records a judgement.',
		source: 'EU AI Act, Articles 3(23) and 25',
	},
	{
		title: 'Model risk',
		body: 'Set each model\'s risk tier, record independent validations, and find out when a live model has stopped being watched.',
		source: 'SR 26-2, PRA SS1/23, OSFI E-23',
	},
	{
		title: 'Change control plans',
		body: 'Agree up front which changes a model may make without review. Every new version is checked against that plan.',
		source: 'FDA predetermined change control plans',
	},
];

const records = [
	{
		Icon: FileLock,
		title: 'Complete audit trail',
		body: 'Every change is written to the log in the same transaction as the change itself, with who made it. A change that cannot be recorded does not happen.',
	},
	{
		Icon: Lock,
		title: 'Tamper protection',
		body: 'Log entries are sealed in batches into a hash chain. If anyone edits or deletes a past entry, verification fails and shows exactly where.',
	},
	{
		Icon: Scale,
		title: 'Legal hold',
		body: 'Place a model or version on hold while a legal matter is open, and it cannot be deleted. Promotion, edits and archiving keep working.',
	},
];

const infra = [
	{
		Icon: Package,
		title: 'One binary',
		body: 'One Go process serves the console and the Model API. One Deployment, one Helm chart, nothing else to operate.',
	},
	{
		Icon: Database,
		title: 'Your database',
		body: 'SQLite to try it or run at the edge, Postgres in production. It behaves the same on both.',
	},
	{
		Icon: HardDrive,
		title: 'Your storage',
		body: 'Files stay in your S3-compatible storage, OCI registry or filesystem. Lineage keeps the pointers.',
	},
	{
		Icon: KeyRound,
		title: 'Your identity provider',
		body: 'Sign-in stays with your ingress or gateway. Lineage records who made each change.',
	},
];

const guides = [
	{ title: 'Start here', links: [['Introduction', '/start/introduction/'], ['Quickstart', '/start/quickstart/'], ['Data model', '/start/data-model/']] },
	{ title: 'Model API', links: [['Publishing', '/api/publishing/'], ['Promotion', '/api/promotion/'], ['Resolve and delivery', '/api/resolve/']] },
	{ title: 'Provenance', links: [['Lineage and fingerprints', '/api/lineage/'], ['API conventions', '/api/conventions/']] },
	{ title: 'Governance', links: [['Compliance records', '/governance/compliance/'], ['Audit and retention', '/governance/audit/']] },
	{ title: 'Operate', links: [['Configuration', '/operate/configuration/'], ['Deploy with Helm', '/operate/deploy/'], ['Storage and databases', '/operate/storage/'], ['Observability and security', '/operate/observability/']] },
	{ title: 'Clients', links: [['Python SDK and CLI', '/clients/sdk-cli/']] },
];

const COMMAND = 'git clone https://github.com/proseria-research/lineage && cd lineage && make run';
---

<Marketing
	title="Lineage — the model registry for regulated AI"
	description="Lineage is a self-hosted model registry: it stores every version of your ML and AI models, promotes them to production, serves them to inference systems and records every change. One Go binary, your database, your storage."
>
	<section class="hero">
		<div class="shell hero__grid">
			<div class="hero__copy">
				<h1 class="hero__title">The model registry for regulated AI</h1>
				<p class="hero__lede">
					Version, promote and serve your models, and keep the records your risk and compliance teams
					need without anyone filling in a spreadsheet. Self-hosted, in one Go binary.
				</p>
				<div class="hero__actions">
					<a class="btn btn--solid" href="/start/quickstart/">Quickstart</a>
					<a class="btn" href="/start/introduction/">Documentation</a>
				</div>
				<div class="cmd">
					<code class="cmd__text">{COMMAND}</code>
					<button class="cmd__copy" type="button" data-copy={COMMAND} aria-label="Copy the command">
						<Copy size={14} stroke-width={2} />
						<span data-copy-label>Copy</span>
					</button>
				</div>
				<p class="cmd__note">SQLite and local storage. No other dependencies.</p>
			</div>
			<ReleaseDemo />
		</div>
	</section>

	<section class="band" aria-labelledby="how">
		<div class="shell">
			<header class="head">
				<h2 id="how" class="head__title">From training run to production in three calls</h2>
				<p class="head__lede">
					The same three steps from Python, the CLI or plain HTTP. The console shows every one of
					them as it happens.
				</p>
			</header>
			<div class="flow" data-flow>
				<ol class="flow__steps">
					{
						steps.map((st, i) => (
							<li>
								<button class="flow__step" type="button" data-step={i + 1} aria-pressed="false">
									<span class="flow__num" aria-hidden="true">{i + 1}</span>
									<span class="flow__text">
										<span class="flow__title">{st.title}</span>
										<span class="flow__body">{st.body}</span>
									</span>
								</button>
							</li>
						))
					}
				</ol>
				<figure class="script" data-script>
					<figcaption class="script__bar">
						<div class="script__tabs" role="tablist" aria-label="Language">
							{
								scripts.map((sc, k) => (
									<button
										class="script__tab"
										type="button"
										role="tab"
										id={`tab-${sc.id}`}
										aria-controls={`panel-${sc.id}`}
										aria-selected={k === 0 ? "true" : "false"}
										tabindex={k === 0 ? 0 : -1}
										data-lang={sc.id}
									>
										{sc.label}
									</button>
								))
							}
						</div>
						<button class="script__copy" type="button" data-copy={textOf(scripts[0].lines)} data-copy-script aria-label="Copy the script">
							<Copy size={14} stroke-width={2} />
							<span data-copy-label>Copy</span>
						</button>
					</figcaption>
					{
						scripts.map((sc, k) => (
							<pre
								class="script__code"
								role="tabpanel"
								id={`panel-${sc.id}`}
								aria-labelledby={`tab-${sc.id}`}
								data-panel={sc.id}
								data-text={textOf(sc.lines)}
								hidden={k !== 0}
							><code>{sc.lines.map(([step, line]) => (
								<span class="script__line" data-line-step={step} set:html={highlight(line)} />
							))}</code></pre>
						))
					}
				</figure>
			</div>
			<p class="band__foot">
				Serving on KServe? Set <code>storageUri: lineage://fraud-detector/production</code> and the
				storage initializer resolves it at pull time. <a href="/api/resolve/">KServe guide</a>
			</p>
		</div>
	</section>

	<section class="band band--card" aria-labelledby="fp">
		<div class="shell split">
			<div class="split__copy">
				<h2 id="fp" class="head__title">Know what really changed</h2>
				<p>
					Every version can carry four hashes: architecture, layer shapes, precision and weights.
					Lineage compares them, so a change is measured rather than taken on trust.
				</p>
				<p>A retrain is routine. A new architecture deserves a second look, and your reviewers can see which one they are looking at.</p>
				<dl class="verdicts">
					{
						verdicts.map((v) => (
							<div class="verdicts__row" data-current={String(v.name === 'Reweighted')}>
								<dt>{v.name}</dt>
								<dd>{v.plain}</dd>
							</div>
						))
					}
				</dl>
				<p class="split__link"><a href="/api/lineage/">Version comparison</a></p>
			</div>

			<figure class="compare" tabindex="0" aria-describedby="compare-verdict">
				<div class="compare__pair">
					<div class="compare__side">
						<Fingerprint hashes={before.hashes} size={188} />
						<p class="compare__name">1.3.0 <span>in production</span></p>
					</div>
					<div class="compare__side">
						<span class="compare__stack">
							<Fingerprint hashes={after.hashes} size={188} />
							<span class="compare__blink"><Fingerprint hashes={before.hashes} size={188} /></span>
						</span>
						<p class="compare__name">1.4.0 <span>candidate</span></p>
					</div>
				</div>
				<p class="compare__hint">Hover to flip between 1.3.0 and 1.4.0. Whatever moves has changed.</p>
				<ul class="levels">
					{
						levels.map((l) => (
							<li class="levels__row" data-changed={String(l.changed)}>
								<i class={`levels__swatch levels__swatch--${l.key}`} aria-hidden="true" />
								<span class="levels__name">
									{l.label}
									<span class="levels__help">{l.help}</span>
								</span>
								<span class="levels__state">{l.changed ? 'Changed' : 'Same'}</span>
							</li>
						))
					}
				</ul>
				<p class="compare__verdict" id="compare-verdict">
					<strong>Reweighted.</strong> Same architecture, new weights: a retrain.
				</p>
			</figure>
		</div>
	</section>

	<section class="band" aria-labelledby="gov">
		<div class="shell">
			<header class="head">
				<h2 id="gov" class="head__title">Compliance, without the spreadsheet</h2>
				<p class="head__lede">
					The EU AI Act, model risk rules and FDA change control each ask for records. Lineage keeps
					them as your team works, explains every term in plain words, and tells you when something
					needs a person. It never blocks a release or makes the legal call for you.
				</p>
			</header>

			<div class="gov">
				<div class="panel attention">
					<div class="panel__head">
						<h3 class="panel__title">Needs attention</h3>
						<span class="panel__meta">3 items</span>
					</div>
					<ul class="attention__list">
						{
							attention.map((a) => (
								<li class="attention__item" data-tone={a.tone}>
									<span class="attention__icon">
										{a.tone === 'danger' ? <OctagonAlert size={16} stroke-width={2} /> : <TriangleAlert size={16} stroke-width={2} />}
									</span>
									<div class="attention__body">
										<p class="attention__title">{a.title}</p>
										<p class="attention__detail">{a.detail}</p>
										<p class="attention__meta">
											<span>{a.model}</span>
											<span>{a.area}</span>
										</p>
									</div>
									<span class="attention__action">{a.action}</span>
								</li>
							))
						}
					</ul>
					<div class="explain">
						<p class="explain__term">
							<Lightbulb size={14} stroke-width={2} /> Out of date
						</p>
						<p>Something changed after this model was assessed, so the assessment may no longer be accurate.</p>
						<p class="explain__next">
							<strong>What to do:</strong> check whether the category still fits and record the
							assessment again, even if the answer is unchanged.
						</p>
					</div>
				</div>

				<ul class="programmes">
					{
						programmes.map((p) => (
							<li class="programme">
								<h3 class="programme__title">{p.title}</h3>
								<p class="programme__body">{p.body}</p>
								<p class="programme__source">{p.source}</p>
							</li>
						))
					}
				</ul>
			</div>

			<ul class="records">
				{
					records.map(({ Icon, title, body }) => (
						<li class="record">
							<span class="record__icon"><Icon size={18} stroke-width={2} /></span>
							<div>
								<h3 class="record__title">{title}</h3>
								<p class="record__body">{body}</p>
							</div>
						</li>
					))
				}
			</ul>
			<p class="band__foot">
				Guidance on how Lineage works, not legal advice. <a href="/governance/compliance/">Framework mapping</a>
			</p>
		</div>
	</section>

	<section class="band band--card" aria-labelledby="lin">
		<div class="shell">
			<header class="head">
				<h2 id="lin" class="head__title">Trace every model's history</h2>
				<p class="head__lede">
					Record the data a model was trained on, the run that built it and the model it came from.
					When an auditor asks how it was made, or a dataset turns out to be bad, follow the trail
					either way.
				</p>
			</header>
			<LineageMap />
			<p class="band__foot"><a href="/api/lineage/">Recording lineage</a></p>
		</div>
	</section>

	<section class="band" aria-labelledby="infra">
		<div class="shell">
			<header class="head">
				<h2 id="infra" class="head__title">Yours to run</h2>
				<p class="head__lede">
					Self-hosting is not a lite edition. Your models, your records and your audit log stay
					inside your network.
				</p>
			</header>
			<ul class="infra">
				{
					infra.map(({ Icon, title, body }) => (
						<li class="infra__item">
							<span class="infra__icon"><Icon size={20} stroke-width={1.75} /></span>
							<h3 class="infra__title">{title}</h3>
							<p class="infra__body">{body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="band band--card" aria-labelledby="docs">
		<div class="shell">
			<header class="head">
				<h2 id="docs" class="head__title">Documentation</h2>
			</header>
			<ul class="guides">
				{
					guides.map((g) => (
						<li class="guides__group">
							<h3 class="guides__title">{g.title}</h3>
							<ul>
								{g.links.map(([label, href]) => (
									<li><a href={href}>{label}</a></li>
								))}
							</ul>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="closer">
		<div class="shell closer__inner">
			<h2 class="closer__title">Start with one model</h2>
			<p class="closer__lede">
				Run it on your laptop in a minute, or install the Helm chart against your own Postgres and
				bucket. The record starts with the first version you publish.
			</p>
			<div class="hero__actions">
				<a class="btn btn--solid" href="/start/quickstart/">Quickstart</a>
				<a class="btn" href="/operate/deploy/">Deploy with Helm</a>
			</div>
		</div>
	</section>
</Marketing>

<script>
	// Choosing a step lights its lines in the script. Hover previews; click or keyboard pins.
	const flow = document.querySelector<HTMLElement>('[data-flow]');
	if (flow) {
		let pinned = '';
		const buttons = [...flow.querySelectorAll<HTMLButtonElement>('[data-step]')];
		const show = (step: string) => {
			if (step) flow.dataset.active = step;
			else delete flow.dataset.active;
			for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.step === pinned));
			for (const line of flow.querySelectorAll<HTMLElement>('[data-line-step]')) {
				line.classList.toggle('is-lit', !!step && line.dataset.lineStep === step);
			}
		};
		for (const b of buttons) {
			b.addEventListener('mouseenter', () => show(b.dataset.step!));
			b.addEventListener('mouseleave', () => show(pinned));
			b.addEventListener('click', () => {
				pinned = pinned === b.dataset.step ? '' : b.dataset.step!;
				show(pinned);
			});
		}
	}

	// Language tabs: arrow keys move between them, as tabs should.
	const script = document.querySelector<HTMLElement>('[data-script]');
	if (script) {
		const tabs = [...script.querySelectorAll<HTMLButtonElement>('[data-lang]')];
		const copy = script.querySelector<HTMLButtonElement>('[data-copy-script]');
		const select = (tab: HTMLButtonElement) => {
			for (const t of tabs) {
				const on = t === tab;
				t.setAttribute('aria-selected', String(on));
				t.tabIndex = on ? 0 : -1;
				const panel = script.querySelector<HTMLElement>(`[data-panel="${t.dataset.lang}"]`)!;
				panel.hidden = !on;
				if (on && copy) copy.dataset.copy = panel.dataset.text ?? '';
			}
		};
		tabs.forEach((t, k) => {
			t.addEventListener('click', () => select(t));
			t.addEventListener('keydown', (e) => {
				const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
				if (!d) return;
				const next = tabs[(k + d + tabs.length) % tabs.length];
				select(next);
				next.focus();
			});
		});
	}

	for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
		const label = button.querySelector<HTMLElement>('[data-copy-label]');
		let restore: number | undefined;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(button.dataset.copy ?? '');
				if (label) label.textContent = 'Copied';
			} catch {
				// Clipboard access can be refused; say so rather than claiming success.
				if (label) label.textContent = 'Select and copy';
			}
			window.clearTimeout(restore);
			restore = window.setTimeout(() => {
				if (label) label.textContent = 'Copy';
			}, 2000);
		});
	}
</script>
