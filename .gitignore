/bin/
/data/
*.db
*.db-*
/lineage
node_modules/
# The built console is produced by `make web` and embedded only under the `console` build
# tag (see internal/api/adminui/static_*.go). It is not committed — a plain `go build`
# compiles the stub without it.
internal/api/adminui/web/dist/
.vite/
*.tsbuildinfo
# Python bytecode, anywhere it appears.
__pycache__/
*.py[cod]
# Python SDK build output. Anchored to the package: a bare `build/`/`dist/` would swallow
# any directory of that name elsewhere in the tree.
/sdk/python/build/
/sdk/python/dist/
/sdk/python/*.egg-info/